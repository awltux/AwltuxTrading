# =============================================================================
# AwltuxTrading configuration -- copy to `.env` and fill in.
# NEVER commit the real .env. Everything here is a secret or a machine-specific
# path; tunable analysis/decision parameters live in config/config.yaml.
# =============================================================================

# --- runtime ------------------------------------------------------------------
# Where the SQLite database and the raw provider cache live.
AWLTUX_DATA_DIR=./data
AWLTUX_LOG_LEVEL=INFO
AWLTUX_HOST=0.0.0.0
AWLTUX_PORT=8080

# Restrict outbound requests to IPv4. Set this to true if you use an
# IP-restricted provider key (Trading 212 supports this).
#
# Why it matters: a dual-stack machine presents a different source address
# depending on which family the connection uses, so allowlisting your IPv4
# address achieves nothing if the client then connects over IPv6. Run
# `awltux doctor` to see the addresses providers actually see.
AWLTUX_FORCE_IPV4=false

# --- Trading 212 --------------------------------------------------------------
# Create keys in the T212 app. Keys are PER ENVIRONMENT: a demo key returns 401
# against the live base URL and vice versa.
# Help: https://helpcentre.trading212.com/hc/en-us/articles/14584770928157
AWLTUX_T212_API_KEY=
AWLTUX_T212_API_SECRET=
# "demo" (paper, https://demo.trading212.com) or "live" (real money).
# The app is advisory-only by default; see AWLTUX_ALLOW_LIVE_ORDERS.
AWLTUX_T212_ENV=demo
# Hard safety catch. Order placement is refused unless this is explicitly true
# AND T212_ENV=live. Leave false unless you really mean it.
AWLTUX_ALLOW_LIVE_ORDERS=false

# --- DeepSeek (investigation + summarisation, and fallback decision engine) ----
# https://platform.deepseek.com
AWLTUX_DEEPSEEK_API_KEY=
AWLTUX_DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- JEV / TypeSafe AI (primary decision engine) ------------------------------
# Early access: https://console.typesafe.ai/keys
# Leave blank to run on the DeepSeek / offline decision engines.
AWLTUX_TYPESAFE_API_KEY=

# --- Fal.ai (embeddings: grouping the several reports of one event) ------------
# https://fal.ai/dashboard/keys
#
# The names below are the ones `.env` uses and the ones the vendor documents. Each
# also accepts an AWLTUX_-prefixed spelling (`AWLTUX_FALAI_KEY`, `AWLTUX_FAL_ADMIN_KEY`)
# because every other credential here takes that prefix; setting both is pointless.
#
# NOTE: the `openai/*` embedding family is refused by this route with a 401 naming
# the organization behind the key, while other vendors' models answer on the same
# URL with the same key. See `news.embeddings.model` in config/config.yaml.
FAL_KEY=
# Used ONLY to read the account balance. fal's Platform API endpoint
# `GET /account/billing` refuses a model key with a plain 403 -- its docs say some
# Platform APIs need an Admin-scope key. Kept separate from FAL_KEY so the credential
# that can move money is not the one spent on every embedding request.
# Leave blank and the status banner simply says the balance is not readable.
FAL_ADMIN_KEY=

# --- SEC EDGAR ----------------------------------------------------------------
# REQUIRED and enforced by the SEC: a declared User-Agent carrying a real
# contact. A default/absent UA gets HTTP 403 "Undeclared Automated Tool".
AWLTUX_SEC_USER_AGENT=AwltuxTrading/0.1 (personal research; your@email.example)

# --- Companies House ----------------------------------------------------------
# Free key: https://developer.company-information.service.gov.uk/
# Auth is HTTP Basic with the API key as the USERNAME and a blank password.
AWLTUX_COMPANIES_HOUSE_API_KEY=

# --- News providers (all optional; RSS needs no key) --------------------------
AWLTUX_FINNHUB_API_KEY=
AWLTUX_MARKETAUX_API_KEY=
AWLTUX_ALPHAVANTAGE_API_KEY=
# Reddit is optional retail sentiment. Non-commercial use only.
AWLTUX_REDDIT_CLIENT_ID=
AWLTUX_REDDIT_CLIENT_SECRET=
