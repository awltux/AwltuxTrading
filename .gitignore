# secrets -- never commit
.env
*.key
*.pem

# data volume (sqlite db + raw provider cache)
data/
*.db
*.db-wal
*.db-shm
*.sqlite3

# python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# generated at image build time: the commit history baked into the package, so
# the Info page can name the revision an installed copy is running. Not source,
# and keeping it out of git is what makes the build's dirty-tree check reliable.
src/awltux/build_info.json

# local scratch: pip's temp dir and the test suite's working directory. Both
# live inside the repo so they work under a file-access sandbox.
.pip-tmp/
.tests-tmp/
# pytest leaves these behind when a sandbox denies its cache directory.
pytest-cache-files-*/

# Research scratch. Long-lived background agents fetch papers and extract their
# text; that material is large, third-party and not source, so it must never be
# committed. The canonical home for it is .tests-tmp/; these patterns exist
# because a stray directory at the repo root should not be able to land in a
# commit just because someone ran `git add -A`.
.tmp/
_tmp/
.pdftools/
_news_pdfs/
papers/
research/
pylibs/
wtmp/
_*.py
_wtest.txt
*.pdf

# editors / os
.vscode/
.idea/
.DS_Store
Thumbs.db

# logs
*.log
logs/
